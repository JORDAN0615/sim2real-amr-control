<?xml version="1.0"?>
<package format="3">
  <name>apriltag_amr</name>
  <version>0.1.0</version>
  <description>ROS 2 AMR demo nodes for multi-camera object mission orchestration.</description>
  <maintainer email="jordan@example.com">jordan</maintainer>
  <license>MIT</license>

  <depend>geometry_msgs</depend>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>yolo_msgs</depend>

  <exec_depend>ros2launch</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
